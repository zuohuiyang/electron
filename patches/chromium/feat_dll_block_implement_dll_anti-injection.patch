+bool GetBeaconState(int& state) {
+  const auto path = electron::GetDllBlockerRegistryPath();
+  if (path.empty()) {
+    return false;
+  }
+  DWORD value = blocklist::BLOCKLIST_DISABLED;
+  if (!nt::QueryRegValueDWORD(
+          nt::HKCU, nt::NONE,
+          (path + blocklist::kRegistryBeaconKeyName).c_str(),
+          blocklist::kBeaconState, &value) ||
+      value >= blocklist::BLOCKLIST_STATE_MAX) {
+    state = blocklist::BLOCKLIST_DISABLED;
+    return true;
+  }
+  state = static_cast<int>(value);
+  return true;
+}
+
+bool SetBeaconState(int state) {
+  const auto path = electron::GetDllBlockerRegistryPath();
+  if (path.empty() || state < blocklist::BLOCKLIST_DISABLED ||
+      state >= blocklist::BLOCKLIST_STATE_MAX) {
+    return false;
+  }
+  HANDLE key = nullptr;
+  if (!nt::CreateRegKey(nt::HKCU,
+                        (path + blocklist::kRegistryBeaconKeyName).c_str(),
+                        KEY_SET_VALUE, &key)) {
+    return false;
+  }
+  const bool success =
+      nt::SetRegValueDWORD(key, blocklist::kBeaconState, state);
+  nt::CloseRegKey(key);
+  return success;
+}
+
 }  // namespace third_party_dlls
