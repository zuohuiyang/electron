diff --git a/chrome/chrome_elf/third_party_dlls/electron_blocklist.cc b/chrome/chrome_elf/third_party_dlls/electron_blocklist.cc
new file mode 100644
index 0000000000000000000000000000000000000000..939e63abda11de4d0b933c3bc46229dc17c7beb7
--- /dev/null
+++ b/chrome/chrome_elf/third_party_dlls/electron_blocklist.cc
@@ -0,0 +1,177 @@
+// Copyright (c) Electron contributors. All rights reserved.
+// Use of this source code is governed by the MIT license that can be
+// found in the LICENSE file.
+
+#include "chrome/chrome_elf/third_party_dlls/electron_blocklist.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <string_view>
+#include <vector>
+
+#include "chrome/chrome_elf/nt_registry/nt_registry.h"
+#include "chrome/chrome_elf/third_party_dlls/packed_list_format.h"
+#include "electron/shell/common/dll_blocker_config.h"
+#include "third_party/jsoncpp/source/include/json/reader.h"
+#include "third_party/jsoncpp/source/include/json/writer.h"
+
+namespace third_party_dlls {
+namespace {
+
+constexpr wchar_t kBlocklistValue[] = L"TTBlocklist";
+
+// Written once in DllMain before installing the hook, then read-only.
+std::vector<std::string>& Blocklist() {
+  static auto* const blocklist = new std::vector<std::string>();
+  return *blocklist;
+}
+
+std::string& CurrentBlocklist() {
+  static auto* const blocklist = new std::string();
+  return *blocklist;
+}
+
+bool UTF8ToWide(std::string_view value, std::wstring* result) {
+  if (value.empty() || value.size() > std::numeric_limits<int>::max()) {
+    return false;
+  }
+  const int length =
+      ::MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value.data(),
+                            static_cast<int>(value.size()), nullptr, 0);
+  if (length == 0) {
+    return false;
+  }
+  result->resize(length);
+  return ::MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value.data(),
+                               static_cast<int>(value.size()), result->data(),
+                               length) == length;
+}
+
+bool WideToUTF8(const std::wstring& value, std::string* result) {
+  if (value.empty() || value.size() > std::numeric_limits<int>::max()) {
+    return false;
+  }
+  const int length = ::WideCharToMultiByte(
+      CP_UTF8, WC_ERR_INVALID_CHARS, value.data(),
+      static_cast<int>(value.size()), nullptr, 0, nullptr, nullptr);
+  if (length == 0) {
+    return false;
+  }
+  result->resize(length);
+  return ::WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value.data(),
+                               static_cast<int>(value.size()), result->data(),
+                               length, nullptr, nullptr) == length;
+}
+
+}  // namespace
+
+bool WriteBlocklistToRegistry(const char* blocklist, size_t size) {
+  const auto path = electron::GetDllBlockerRegistryPath();
+  if (path.empty() || (!blocklist && size != 0)) {
+    return false;
+  }
+
+  Json::Value names(Json::arrayValue);
+  std::string_view remaining(blocklist ? blocklist : "", size);
+  while (!remaining.empty()) {
+    const size_t end = remaining.find('\0');
+    if (end == std::string_view::npos || end == 0) {
+      return false;
+    }
+    std::wstring name;
+    if (!UTF8ToWide(remaining.substr(0, end), &name)) {
+      return false;
+    }
+    names.append(std::string(remaining.substr(0, end)));
+    remaining.remove_prefix(end + 1);
+  }
+  Json::StreamWriterBuilder writer;
+  writer["indentation"] = "";
+  std::wstring registry_value;
+  if (!UTF8ToWide(Json::writeString(writer, names), &registry_value)) {
+    return false;
+  }
+
+  HANDLE key = nullptr;
+  if (!nt::CreateRegKey(nt::HKCU, (path + kThirdPartyRegKeyName).c_str(),
+                        KEY_SET_VALUE, &key)) {
+    return false;
+  }
+  const bool success = nt::SetRegValueSZ(key, kBlocklistValue, registry_value);
+  nt::CloseRegKey(key);
+  return success;
+}
+
+ThirdPartyStatus InitElectronBlocklist() {
+  const auto path = electron::GetDllBlockerRegistryPath();
+  if (path.empty()) {
+    return ThirdPartyStatus::kFileEmpty;
+  }
+  std::wstring registry_value;
+  if (!nt::QueryRegValueSZ(nt::HKCU, nt::NONE,
+                           (path + kThirdPartyRegKeyName).c_str(),
+                           kBlocklistValue, &registry_value)) {
+    return ThirdPartyStatus::kFileEmpty;
+  }
+  std::string json;
+  if (!WideToUTF8(registry_value, &json)) {
+    return ThirdPartyStatus::kFileEmpty;
+  }
+  Json::CharReaderBuilder builder;
+  Json::CharReaderBuilder::strictMode(&builder.settings_);
+  builder["collectComments"] = false;
+  builder["stackLimit"] = 16;
+  std::unique_ptr<Json::CharReader> reader(builder.newCharReader());
+  Json::Value names;
+  if (!reader->parse(json.data(), json.data() + json.size(), &names, nullptr) ||
+      !names.isArray()) {
+    return ThirdPartyStatus::kFileEmpty;
+  }
+
+  std::vector<std::string> blocklist;
+  std::string current_blocklist;
+  for (const auto& name : names) {
+    // Preserve the original behavior of ignoring non-string entries.
+    if (!name.isString()) {
+      continue;
+    }
+    std::string utf8 = name.asString();
+    std::wstring validated_name;
+    if (utf8.find('\0') != std::string::npos ||
+        !UTF8ToWide(utf8, &validated_name)) {
+      continue;
+    }
+    // Match the ASCII case folding used by GetDataFromImage().
+    for (auto& character : utf8) {
+      if (character >= 'A' && character <= 'Z') {
+        character += 'a' - 'A';
+      }
+    }
+    current_blocklist.append(utf8);
+    current_blocklist.push_back('\0');
+    blocklist.push_back(std::move(utf8));
+  }
+  Blocklist() = std::move(blocklist);
+  CurrentBlocklist() = std::move(current_blocklist);
+  return Blocklist().empty() ? ThirdPartyStatus::kFileEmpty
+                             : ThirdPartyStatus::kSuccess;
+}
+
+bool IsElectronDllBlocked(const std::string& name) {
+  return !name.empty() && std::find(Blocklist().begin(), Blocklist().end(),
+                                    name) != Blocklist().end();
+}
+
+bool GetCurrentDllBlocklist(const char** blocklist, size_t* size) {
+  if (!blocklist || !size) {
+    return false;
+  }
+  *blocklist = CurrentBlocklist().data();
+  *size = CurrentBlocklist().size();
+  return true;
+}
+
+}  // namespace third_party_dlls
